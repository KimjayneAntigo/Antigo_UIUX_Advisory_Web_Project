# Disable PHP execution in uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Deny direct access to script execution
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|shtml|cgi|pl|exe)$">
    Order allow,deny
    Deny from all
</FilesMatch>

Options -Indexes -ExecCGI
